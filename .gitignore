# Binaries
/bin/
/dist/

# Go build cache
*.test
*.test.exe
*.out
coverage.out
.coverage.out
.gotmp/
.testbin/

# Environment secrets — NEVER commit
.env

# IDE
.idea/
.vscode/settings.json
.vscode/mcp.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Excel lock files (created while a tracker is open)
~$*.xlsx

# Key material
config/keys/*.json
config/keys/*.pem

# Playwright E2E (browsers and run artefacts are large and machine-specific)
node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/.cache/

# Playwright snapshots are regenerated on every run
e2e/snapshots/

# Ad-hoc live-verification screenshots (driven by hand against a running
# stack, not by the committed suite) — same reasoning as e2e/snapshots/
e2e/live-test/

# Demo walkthrough recordings (scripts/record_demo.sh). Multi-megabyte binaries
# regenerated from the live stack on demand — the specs that produce them are
# committed, the output is not.
e2e/demo-recordings/
e2e/demo-videos/
e2e/demo-frames/
