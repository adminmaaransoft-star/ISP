# BSS/OSS ISP Platform — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to version control.
# All secrets must be at least 32 characters long.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_SECURE_PASSWORD=change_me_in_production_at_least_32chars

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_32chars_minimum!!

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_WEBHOOK_SECRET=change_me_in_production_hmac_secret
# API credentials for creating payment links (portal one-tap renewal).
# Leaving these unset disables /portal/renew (returns 503) without blocking startup.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Redis Sentinel ───────────────────────────────────────────────────────────
REDIS_MASTER_NAME=bss_master
REDIS_SENTINEL_ADDRS=bss_redis_sentinel_1:26379,bss_redis_sentinel_2:26379,bss_redis_sentinel_3:26379

# ── RADIUS ────────────────────────────────────────────────────────────────────
RADIUS_SECRET=change_me_shared_radius_secret_32c
RADIUS_ADDR=:1812

# ── AES Key Store ─────────────────────────────────────────────────────────────
# In production point this to your secret manager (Vault, AWS Secrets Manager, etc.)
AES_KEY_STORE_URL=local:./config/keys/aes_keys.json

# ── WhatsApp Business API (Meta Cloud API) ────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change_me_random_string

# ── SMS Gateway ───────────────────────────────────────────────────────────────
SMS_GATEWAY_PROVIDER=msg91
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key
SMS_GATEWAY_SENDER_ID=BSSOSS

# ── PagerDuty ────────────────────────────────────────────────────────────────
PAGERDUTY_ROUTING_KEY=your_pagerduty_events_v2_routing_key

# ── Reverse Proxy / TLS (SecD §9.7) ─────────────────────────────────────────────
# A real public hostname makes the reverse_proxy container request a
# Let's Encrypt certificate automatically. Leaving this as "localhost" (the
# default) makes it issue a certificate from Caddy's own local CA instead —
# fine for local/demo use, but clients must connect with `curl -k` since that
# CA is not in any public trust store.
DOMAIN=localhost

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_FORMAT=json
LOG_LEVEL=info
API_ADDR=:8080
